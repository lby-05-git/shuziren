# OpenAI-compatible LLM endpoint used for product scripts and danmaku replies.
LIVE_LLM_API_KEY=replace-with-your-key
LIVE_LLM_BASE_URL=https://api.example.com/v1
LIVE_LLM_MODEL=replace-with-model-name

# Optional runtime overrides.
PORT=7860
DIGITAL_HUMAN_MODELS=/root/autodl-tmp/models
COSYVOICE_HOME=/root/autodl-tmp/projects/CosyVoiceOfficial
MUSETALK_HOME=/root/autodl-tmp/projects/MuseTalk
LIVEPORTRAIT_HOME=/root/autodl-tmp/projects/LivePortrait
